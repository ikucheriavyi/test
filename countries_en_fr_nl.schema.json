{
  "description": "Довідник «Країни світу» (англійська, французька та нідерландська назви)",
  "type": "object",
  "required": [
    "code",
    "nameEng",
    "nameFr",
    "nameNl"
  ],
  "properties": {
    "code": {
      "description": "Код країни (ISO 3166-1 numeric)",
      "type": "string",
      "pattern": "^[0-9]{3}$",
      "public": true
    },
    "nameEng": {
      "description": "Англійська коротка назва",
      "type": "string",
      "public": true
    },
    "nameFr": {
      "description": "Французька коротка назва",
      "type": "string",
      "public": true
    },
    "nameNl": {
      "description": "Нідерландська коротка назва",
      "type": "string",
      "public": true
    }
  }
}
