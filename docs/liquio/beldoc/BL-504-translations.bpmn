[{"localizationLanguageCode": "nl", "key": "LANG_NATIONALITY", "value": "Nationaliteit", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "eng", "key": "LANG_NATIONALITY", "value": "Nationality", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "fr", "key": "LANG_NATIONALITY", "value": "Nationalité", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "nl", "key": "LANG_WORK_AUTHORIZATION_IN_BELGIUM", "value": "Werkvergunning voor België", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "eng", "key": "LANG_WORK_AUTHORIZATION_IN_BELGIUM", "value": "Work authorization in Belgium", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "fr", "key": "LANG_WORK_AUTHORIZATION_IN_BELGIUM", "value": "Permis de travail en Belgique", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "nl", "key": "LANG_WORK_PERMIT_REQUIRED_SUBJECT", "value": "Werkvergunning voor bestuurder", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "eng", "key": "LANG_WORK_PERMIT_REQUIRED_SUBJECT", "value": "Work permit for director", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "fr", "key": "LANG_WORK_PERMIT_REQUIRED_SUBJECT", "value": "Permis de travail pour l'administrateur", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "nl", "key": "LANG_WORK_PERMIT_REQUIRED_TEXT", "value": "Alle bestuurders zijn buitenlanders, maar geen van hen beschikt over een werkvergunning voor België. Zonder deze vergunning is het niet mogelijk de inschrijving van de vennootschap af te ronden.", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "eng", "key": "LANG_WORK_PERMIT_REQUIRED_TEXT", "value": "All directors are foreign nationals, but none of them holds a work permit for Belgium. Without this, it is not possible to complete the company registration.", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "fr", "key": "LANG_WORK_PERMIT_REQUIRED_TEXT", "value": "Tous les administrateurs sont des ressortissants étrangers, mais aucun d'entre eux ne dispose d'un permis de travail en Belgique. Or, sans cela, il est impossible de finaliser l'immatriculation de la société.", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "nl", "key": "LANG_WORK_PERMIT_REQUIRED_HINT", "value": "Zodra ten minste één buitenlandse bestuurder een werkvergunning heeft verkregen, gelieve de aanvraag aan te passen en opnieuw in te dienen", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "eng", "key": "LANG_WORK_PERMIT_REQUIRED_HINT", "value": "Once at least one foreign director has obtained a work permit, please revise the application and resubmit it", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "fr", "key": "LANG_WORK_PERMIT_REQUIRED_HINT", "value": "Une fois qu'au moins un administrateur étranger aura obtenu un permis de travail, veuillez modifier la demande et la soumettre à nouveau", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "nl", "key": "LANG_WORKPERMITREQUIRED", "value": "WERKVERGUNNING VEREIST", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "eng", "key": "LANG_WORKPERMITREQUIRED", "value": "WORK PERMIT REQUIRED", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}, {"localizationLanguageCode": "fr", "key": "LANG_WORKPERMITREQUIRED", "value": "PERMIS DE TRAVAIL REQUIS", "createdAt": "2026-09-30T06:49:56.259Z", "updatedAt": "2026-09-30T06:49:56.259Z"}]